# Copy to .env.local and fill in real values from your Supabase project.
# NEVER commit .env or .env.local.

# ----- Supabase -----
# Public, exposed to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row-Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- VirusTotal (Phase 2 only) -----
# Free public API key. Used by /api/scan proxy.
VIRUSTOTAL_API_KEY=

# ----- Project-wide -----
# Random high-entropy string used as a salt when hashing PII.
# Generate once with: openssl rand -base64 32
PROJECT_SALT=

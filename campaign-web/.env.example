# Copy to .env.local and fill in real values from your Supabase project.
# NEVER commit .env or .env.local.

# ----- Supabase -----
# Public, exposed to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row-Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ----- VirusTotal (Phase 2) -----
# Free public API key from https://www.virustotal.com/gui/my-apikey.
# Used by the /api/scan proxy. Never ships in the mobile binary.
VIRUSTOTAL_API_KEY=

# Shared secret the Flutter scanner app sends in the X-Scan-Key header
# with every /api/scan request. Without it, the proxy returns 401 so
# random internet traffic can't burn through the VirusTotal quota.
# Generate once with: openssl rand -base64 32
SCAN_PROXY_API_KEY=

# ----- Project-wide -----
# Random high-entropy string used as a salt when hashing PII.
# Generate once with: openssl rand -base64 32
PROJECT_SALT=
